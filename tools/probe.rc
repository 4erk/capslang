#include <windows.h>
1 RT_MANIFEST "probe.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE | VS_FF_PRIVATEBUILD
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "CapsLang read-only inventory (not a release candidate)\0"
   VALUE "FileVersion", "1.1.0-inventory\0"
   VALUE "ProductName", "CapsLang Inventory\0"
   VALUE "PrivateBuild", "Read-only inventory; interactive probe retired\0"
   VALUE "OriginalFilename", "CapsLangInventory.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
